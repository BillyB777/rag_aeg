  <data key="d4">unknown_source</data>
  <data key="d5">1755420994</data>
</node>
<node id="Article 12">
  <data key="d0">Article 12</data>
  <data key="d1">category</data>
  <data key="d2">Article 12 addresses concerns regarding conflicts of interest that beneficiaries must manage.</data>
  <data key="d3">chunk-66775d2ca4e61f236e59e3423f42a76e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420995</data>
</node>
