  <data key="d1">category</data>
  <data key="d2">Cascading Risk refers to the potential for risk exposure to spread throughout the AI supply chain due to vulnerabilities in interconnected AI components.</data>
  <data key="d3">chunk-1c2a45c222140df04434355f127ac357</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755422756</data>
