  <data key="d0">Trusted Dataset</data>
  <data key="d1">category</data>
  <data key="d2">Trusted Dataset refers to data that has been validated for quality and security, to be included in the Trusted Data Pool as per the research goals.&lt;SEP&gt;Trusted Dataset refers to datasets that have been evaluated and verified for quality and reliability in supporting AI model training.</data>
  <data key="d3">chunk-e539403d1165017fce38ab358660244c&lt;SEP&gt;chunk-58bbe4f5990fa2bf4939eaf879cf277a</data>
