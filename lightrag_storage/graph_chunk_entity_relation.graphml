  <data key="d0">Project-Based Remuneration</data>
  <data key="d1">category</data>
  <data key="d2">Project-Based Remuneration pertains to supplementary payments made for work on specific projects funded by the Horizon Program.</data>
  <data key="d3">chunk-9722302d2df0ff82bdb9f924fc7dbf39</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420992</data>
</node>
<node id="National Projects Reference">
  <data key="d0">National Projects Reference</data>
  <data key="d1">category</data>
  <data key="d2">National Projects Reference is a benchmark for remuneration determined by national law or collective agreements for similar projects funded by national schemes.</data>
  <data key="d3">chunk-9722302d2df0ff82bdb9f924fc7dbf39</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420992</data>
</node>
<node id="EU Directives on Public Procurement">
  <data key="d0">EU Directives on Public Procurement</data>
  <data key="d1">category</data>
  <data key="d2">The EU Directives on Public Procurement outline the legal framework and regulations governing the procurement practices of contracting authorities and entities.</data>
  <data key="d3">chunk-9941c6cbac26f2073168a5b30c17afcf</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420992</data>
</node>
<node id="Contracting Authorities/Entities">
  <data key="d0">Contracting Authorities/Entities</data>
  <data key="d1">organization</data>
  <data key="d2">Contracting Authorities/Entities refer to organizations that must comply with national laws on public procurement as defined in the EU Directives.</data>
  <data key="d3">chunk-9941c6cbac26f2073168a5b30c17afcf</data>
