<node id="Open Access Repositories">
  <data key="d0">Open Access Repositories</data>
  <data key="d1">category</data>
  <data key="d2">Open Access Repositories are platforms where scientific publications can be self-archived to ensure public access to research findings.&lt;SEP&gt;Open Access repositories are platforms that allow for the self-archiving of scientific publications, promoting easy public access to research.&lt;SEP&gt;Open Access repositories are platforms where research outputs, including publications and datasets, are made freely accessible to the public.</data>
  <data key="d3">chunk-93ceeb9a936cfc772c88beda8e90f8f8&lt;SEP&gt;chunk-39e3880f9db30fa735ddba92055e2f7b&lt;SEP&gt;chunk-f53ece2cac0b6e9ce607bb71e4557106</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755424938</data>
</node>
