  <data key="d0">Article 17.2</data>
  <data key="d1">category</data>
  <data key="d2">Article 17.2 involves visibility requirements that beneficiaries must fulfill.</data>
  <data key="d3">chunk-66775d2ca4e61f236e59e3423f42a76e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420995</data>
</node>
<node id="Article 18">
  <data key="d0">Article 18</data>
  <data key="d1">category</data>
  <data key="d2">Article 18 covers specific rules for the actions carried out by beneficiaries.</data>
