</node>
<node id="Dispute Resolution">
  <data key="d0">Dispute Resolution</data>
  <data key="d1">category</data>
  <data key="d2">Dispute Resolution is a process defined within the Consortium Agreement for addressing conflicts among the parties.</data>
  <data key="d3">chunk-8c12a8ce9dbccebc341927add84979a3</data>
