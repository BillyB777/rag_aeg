  <data key="d0">Nuremberg Code</data>
  <data key="d1">category</data>
  <data key="d2">The Nuremberg Code outlines ethical principles for conducting research, ensuring informed consent and ethical scientific experimentation.</data>
  <data key="d3">chunk-568b86d237d97cad5eb967bde956e56d</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755419866</data>
