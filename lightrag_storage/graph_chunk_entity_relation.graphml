  <data key="d4">unknown_source</data>
  <data key="d5">1755422743</data>
</node>
<node id="defence flow">
  <data key="d0">defence flow</data>
  <data key="d1">category</data>
  <data key="d2">Defence flow outlines the process of implementing multiple defensive strategies throughout the AI model lifecycle to mitigate risks of adversarial attacks.</data>
