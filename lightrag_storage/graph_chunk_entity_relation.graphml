<node id="WP4 Lead Beneficiary 7 - TID">
  <data key="d0">WP4 Lead Beneficiary 7 - TID</data>
  <data key="d1">organization</data>
  <data key="d2">TID is identified as the lead beneficiary for work package WP4 within the CoEvolution project, focusing on AI model assessment and enhancement.</data>
  <data key="d3">chunk-ec24c7171d1f9190641a3a8d0adbdf96</data>
  <data key="d4">unknown_source</data>
