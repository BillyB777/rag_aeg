  <data key="d0">European Union High-Level Expert Group on AI (AI HLEG)</data>
  <data key="d1">organization</data>
  <data key="d2">The AI HLEG is a directive group established by the European Union to ensure trust and fairness in AI applications across industries.</data>
  <data key="d3">chunk-b9bed3e842d53d9202844347e7525f7f</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420457</data>
