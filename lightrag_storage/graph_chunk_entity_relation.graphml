<node id="white-box attacks">
  <data key="d0">white-box attacks</data>
  <data key="d1">category</data>
  <data key="d2">White-box attacks are conducted by adversaries who possess complete knowledge of the AI model and its internal workings, allowing for targeted manipulations.&lt;SEP&gt;White-box attacks are threats posed by cybercriminals who have complete knowledge of an AI model's internal workings.</data>
  <data key="d3">chunk-fd5d99a66a08e8bad40aa04612a33b6b&lt;SEP&gt;chunk-27653816af61fd8b863293d976ca9654</data>
  <data key="d4">unknown_source</data>
