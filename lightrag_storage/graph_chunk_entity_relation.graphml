<node id="Tier 2">
  <data key="d0">Tier 2</data>
  <data key="d1">category</data>
  <data key="d2">Tier 2 allows access to Assessment and Audit Results along with Risk disclosures without revealing internal model details.&lt;SEP&gt;Tier 2 provides access to assessment and audit results along with risk disclosures without revealing the internal details of the AI model.</data>
  <data key="d3">chunk-a4c7b68e7ffd62eeeb39e4a632bfc606&lt;SEP&gt;chunk-87e3ec6d317ec9c38e6e681a34f1fe29</data>
