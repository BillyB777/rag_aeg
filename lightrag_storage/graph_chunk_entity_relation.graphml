<node id="DESCA Model Consortium Agreement">
  <data key="d0">DESCA Model Consortium Agreement</data>
  <data key="d1">organization</data>
  <data key="d2">DESCA is a model consortium agreement framework used for Horizon Europe projects ensuring compliance and governance.&lt;SEP&gt;The DESCA Model Consortium Agreement is a template agreement used as a basis for collaboration in Horizon Europe projects.&lt;SEP&gt;The DESCA Model Consortium Agreement provides a standard framework for creating consortium agreements for Horizon Europe projects.</data>
  <data key="d3">chunk-698ec7ba0564e6bef01ced0b3d7984a0&lt;SEP&gt;chunk-7f271cb21c3e352192b6e5d9f263eec2&lt;SEP&gt;chunk-18adeb9ccf3125e3ad8c543104b15e6b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755419429</data>
</node>
<node id="Controlled License Terms">
  <data key="d0">Controlled License Terms</data>
  <data key="d1">category</data>
  <data key="d2">Controlled License Terms defines conditions under which a license allows the use, copying, modification, and distribution of software or other works related to the project.&lt;SEP&gt;Controlled License Terms refers to specific terms that dictate the sharing and modification of software and intellectual property within the consortium.</data>
  <data key="d3">chunk-698ec7ba0564e6bef01ced0b3d7984a0&lt;SEP&gt;chunk-7f271cb21c3e352192b6e5d9f263eec2</data>
