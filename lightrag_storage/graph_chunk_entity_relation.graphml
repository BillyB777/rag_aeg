  <data key="d1">category</data>
  <data key="d2">Open research collaboration platforms facilitate cooperative work among researchers, particularly in sharing datasets and software.</data>
  <data key="d3">chunk-39e3880f9db30fa735ddba92055e2f7b</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420454</data>
</node>
<node id="Gender Aspects">
  <data key="d0">Gender Aspects</data>
  <data key="d1">category</data>
  <data key="d2">Gender Aspects refer to the considerations related to gender that must be taken into account in various phases of the project’s methodologies.&lt;SEP&gt;Gender aspects refer to considerations related to gender that may impact dataset biases and human-machine interactions in AI systems.</data>
  <data key="d3">chunk-93ceeb9a936cfc772c88beda8e90f8f8&lt;SEP&gt;chunk-39e3880f9db30fa735ddba92055e2f7b</data>
  <data key="d4">unknown_source</data>
