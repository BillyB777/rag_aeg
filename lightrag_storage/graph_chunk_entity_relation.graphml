<node id="Interim Payments">
  <data key="d0">Interim Payments</data>
  <data key="d1">category</data>
  <data key="d2">Interim payments refer to the reimbursements made for eligible costs and contributions claimed during the implementation of the project action.&lt;SEP&gt;Interim payments relate to financial disbursements made to beneficiaries during the project duration, measured against approved costs.</data>
  <data key="d3">chunk-340cab0aeae7a8a4e864f5fb97fb2b86&lt;SEP&gt;chunk-897fe30d76da92eef8ab39f6f37362da</data>
  <data key="d4">unknown_source</data>
