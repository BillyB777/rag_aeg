<node id="debit note">
  <data key="d0">debit note</data>
  <data key="d1">category</data>
  <data key="d2">A debit note is a document issued to formally request payment for amounts owed by beneficiaries concerning their grants and contributions.&lt;SEP&gt;A debit note is a document sent to beneficiaries detailing payment obligations and amounts to be recovered by the granting authority.</data>
  <data key="d3">chunk-153d0d25b1dc6cfa0bcf7a7947b40d51&lt;SEP&gt;chunk-c83c5cc0d6d218713cd2c6fd9873d16c</data>
