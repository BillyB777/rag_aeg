  <data key="d0">Article 14</data>
  <data key="d1">category</data>
  <data key="d2">Article 14 sets out ethical obligations that beneficiaries and their subcontractors must adhere to.</data>
  <data key="d3">chunk-66775d2ca4e61f236e59e3423f42a76e</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755420995</data>
</node>
