<node id="multi-objective decision support framework">
  <data key="d0">multi-objective decision support framework</data>
  <data key="d1">category</data>
  <data key="d2">A multi-objective decision support framework aims to optimize mitigation actions based on various conflicting objectives, integrating their utility into a single reward function.&lt;SEP&gt;A multi-objective decision support framework integrates multiple performance indicators into the decision-making process to optimize outcomes across various objectives.</data>
  <data key="d3">chunk-c6e06c3c78a2faf8db92a10b50f161ff&lt;SEP&gt;chunk-5092e32b5e7f6b1dc6a316b8941ea4c2</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755424140</data>
</node>
<node id="mobile devices">
  <data key="d0">mobile devices</data>
  <data key="d1">category</data>
  <data key="d2">Mobile devices refer to smartphones and tablets that are utilized in the P4L system for decentralized collaborative learning.</data>
