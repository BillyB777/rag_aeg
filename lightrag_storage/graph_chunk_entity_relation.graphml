  <data key="d5">1755425737</data>
</node>
<node id="Horovod">
  <data key="d0">Horovod</data>
  <data key="d1">organization</data>
  <data key="d2">Horovod is a distributed deep learning framework that allows for the efficient training of deep learning models.&lt;SEP&gt;Horovod is a distributed deep learning training framework that enhances the speed and efficiency of training large AI models.&lt;SEP&gt;Horovod is an open-source distributed deep learning framework, highlighted as part of the AI innovations mentioned.</data>
  <data key="d3">chunk-da375f8b4e8a6a6ffe987d5b6505217a&lt;SEP&gt;chunk-bfe5653cf25a54988a2dce7d8d44ba13&lt;SEP&gt;chunk-3a9e31e2b7ee95a5a60fd9f2a49c2647</data>
