  <data key="d0">Security Runtime Monitoring System</data>
  <data key="d1">category</data>
  <data key="d2">The Security Runtime Monitoring System is a framework designed to observe and report potential adversarial attacks on deployed AI models and manage updates to their defenses.</data>
  <data key="d3">chunk-c59208a0ecce67d91fc2e55e630e3efd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755422742</data>
</node>
<node id="adversarial attack detection and reporting">
  <data key="d0">adversarial attack detection and reporting</data>
  <data key="d1">category</data>
  <data key="d2">Adversarial attack detection and reporting involves identifying and documenting incidents where AI models have been subjected to malicious inputs or strategies aimed at defeating their defenses.</data>
  <data key="d3">chunk-c59208a0ecce67d91fc2e55e630e3efd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755422742</data>
</node>
<node id="telemetry mechanisms">
  <data key="d0">telemetry mechanisms</data>
  <data key="d1">category</data>
  <data key="d2">Telemetry mechanisms are tools used to collect and transmit data about AI model performance and security status, particularly under adversarial conditions.</data>
  <data key="d3">chunk-c59208a0ecce67d91fc2e55e630e3efd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755422743</data>
