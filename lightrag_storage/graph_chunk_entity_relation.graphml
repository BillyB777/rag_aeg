<node id="Data-driven artificial intelligence (AI)">
  <data key="d0">Data-driven artificial intelligence (AI)</data>
  <data key="d1">category</data>
  <data key="d2">Data-driven artificial intelligence (AI) focuses on utilizing large volumes of data to train algorithms that can perform tasks by learning patterns.</data>
