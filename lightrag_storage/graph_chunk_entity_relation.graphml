  <data key="d5">1755424154</data>
</node>
<node id="AI Model Defences">
  <data key="d0">AI Model Defences</data>
  <data key="d1">category</data>
  <data key="d2">AI Model Defences refer to the security measures and strategies implemented to protect AI models from adversarial attacks and ensure their resilience during operation.&lt;SEP&gt;AI Model defences are mechanisms designed to protect AI systems from various threats and adversarial attacks throughout their lifecycle.</data>
  <data key="d3">chunk-ce588e6a41e4a19bd041531ec028f838&lt;SEP&gt;chunk-c59208a0ecce67d91fc2e55e630e3efd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1755422741</data>
</node>
